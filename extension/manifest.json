{
  "manifest_version": 3,
  "name": "Bihar Police Notebook",
  "version": "2.0.0",
  "description": "Bihar Police Notebook — type Hinglish, get Hindi. Letter and FIR diary templates with local document history.",
  "action": {
    "default_title": "Open Bihar Police Notebook",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
